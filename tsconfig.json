{
  "compilerOptions": {
    /* Target & Module System - Tối ưu cho Playwright & Node.js mới */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    /* Strict Mode */
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,

    /* Types Root - Loại bỏ completely Jest types */
    "types": [
      "node",
      "@playwright/test"
    ],

    /* Interop Options */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    /*Path Aliases - Giúp Import ngắn gọn, sạch sẽ (Clean Architecture)*/
    "paths": {
      "@api/*": ["./src/api/*"],
      "@ui/*": ["./src/ui/*"],
      "@utils/*": ["./src/utils/*"],
      "@fixtures/*": ["./src/fixtures/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "test-results",
    "playwright-report"
  ]
}